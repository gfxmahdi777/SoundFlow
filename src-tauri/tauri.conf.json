{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundFlow",
  "version": "1.0.0",
  "identifier": "com.soundflow.audiocontroller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "visible": true,
        "width": 400,
        "height": 560,
        "title": "SoundFlow",
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NEUyMjUwRjJENDk4ODgKUldTSW1OVHlVQ0pPUkdTY2dWK1Rmek9JemdaTGJaMnlnTCt0Y2xxdkg1cUZ5OUxPTmhNSjZMd1MK",
      "endpoints": [
        "https://github.com/gfxmahdi777/SoundFlow/releases/latest/download/latest.json"
      ]
    }
  }
}
